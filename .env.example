# Copy to .env. Never commit real credentials or paste them into chat.
BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
PANEL_URL=https://your-hs-panel.example
PANEL_PASSWORD=
CARD_NUMBER=
CARD_NAME=
SUPPORT_USERNAME=

# Public HTTPS address of this server, not of the HS Panel.
WEBAPP_URL=
PORT=8080

# For deployment, use a persistent directory shared by bot and web server.
# PINGINOO_DATA_DIR=/data

# Public interactive DEMO only. NEVER enable this for the production bot.
PINGINOO_DEMO=0
